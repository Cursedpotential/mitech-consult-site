---
const pathname = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/journey', label: 'Journey' },
  { href: '/lab', label: 'Lab' },
  { href: '/background', label: 'Background' },
];

const active = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="identity" href="/" aria-label="Matthew Salem, home">
      <span class="identity-name">Matthew Salem</span>
      <span class="identity-note">Projects, systems &amp; field notes</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {links.map((link) => (
          <li><a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
