---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Prompt Refiner">
  <main class="dark-theme">
    <h1>AI Prompt Refiner</h1>
    <div class="container">
      <div class="input-section">
        <label for="prompt-input">Enter your prompt:</label>
        <textarea id="prompt-input" rows="10" placeholder="Your prompt here..."></textarea>
      </div>
      <div class="controls">
        <label for="llm-select">Select LLM:</label>
        <select id="llm-select">
          <option value="gpt-4">GPT-4</option>
          <option value="claude">Claude</option>
          <option value="gemini">Gemini</option>
          <option value="llama-3.3-70b-versatile" selected>Llama-3.3-70b-versatile</option>
        </select>
        <button id="refine-button">Refine Prompt</button>
      </div>
      <div class="output-section">
        <label for="refined-output">Refined Prompt:</label>
        <textarea id="refined-output" rows="10" readonly></textarea>
      </div>
    </div>
  </main>
</Layout>

<style>
  .dark-theme {
    background-color: #1a1a1a;
    color: #f0f0f0;
    padding: 2rem;
    min-height: 100vh;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  h1 {
    color: #4CAF50;
    text-align: center;
    margin-bottom: 2rem;
  }
  label {
    font-weight: bold;
    margin-bottom: 0.5rem;
    display: block;
  }
  textarea,
  select,
  button {
    width: 100%;
    padding: 0.8rem;
    border-radius: 5px;
    border: 1px solid #333;
    background-color: #2a2a2a;
    color: #f0f0f0;
    font-size: 1rem;
  }
  textarea {
    resize: vertical;
  }
  select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg fill="%23f0f0f0" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5z"/><path d="M0 0h24v24H0z" fill="none"/></svg>');
    background-repeat: no-repeat;
    background-position: right 0.8rem center;
    background-size: 1.5em;
    padding-right: 2.5rem;
  }
  button {
    background-color: #4CAF50;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: 1rem;
  }
  button:hover {
    background-color: #45a049;
  }
  .controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const refineButton = document.getElementById('refine-button');
    const promptInput = document.getElementById('prompt-input');
    const llmSelect = document.getElementById('llm-select');
    const refinedOutput = document.getElementById('refined-output');

    refineButton.addEventListener('click', async () => {
      const prompt = promptInput.value;
      const model = llmSelect.value;

      if (!prompt) {
        alert('Please enter a prompt to refine.');
        return;
      }

      refinedOutput.value = 'Refining your prompt...';

      try {
        const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${import.meta.env.GROQ_API_KEY}`
          },
          body: JSON.stringify({
            model: model,
            messages: [
              { role: 'system', content: 'You are a helpful assistant that refines user prompts for large language models. Make the prompt more clear, concise, and effective, adding details where necessary to improve the output quality. Focus on making the prompt actionable and specific.' },
              { role: 'user', content: `Refine the following prompt: ${prompt}` }
            ],
            temperature: 0.7,
            max_tokens: 500
          })
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(`API error: ${response.status} - ${errorData.message || response.statusText}`);
        }

        const data = await response.json();
        refinedOutput.value = data.choices[0].message.content;
      } catch (error) {
        console.error('Error refining prompt:', error);
        refinedOutput.value = `Error refining prompt: ${error.message}. Please check the console for more details.`;
      }
    });
  });
</script>
