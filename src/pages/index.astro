---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PhotoMosaic from '@/components/gallery/PhotoMosaic.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.sortOrder - a.data.sortOrder);
const featured = projects.filter((project) => project.data.featured).slice(0, 4);

const capabilities = [
  { title: 'IT & Networking', text: 'Network design, routers, switches, wireless, VoIP, servers, desktop support, and troubleshooting.' },
  { title: 'Low Voltage & Building Systems', text: 'Structured cabling, surveillance, access control, commercial AV, distributed audio, automation, and controls.' },
  { title: 'Electrical & Physical Infrastructure', text: 'Residential and light-commercial wiring, power distribution, service installations, conduit, and integration.' },
  { title: 'Systems & Software', text: 'Linux, Docker, databases, APIs, automation, data processing, self-hosted infrastructure, and system architecture.' },
];

const methods = [
  ['Troubleshooting', 'Walking into systems I did not design, tracing how they work, and deciding what can be repaired, reused, or rebuilt.'],
  ['Systems thinking', 'Looking past the individual device to understand the relationships, dependencies, and failure paths around it.'],
  ['Learning across boundaries', 'Learning the technology required by the problem instead of staying inside one narrow discipline.'],
  ['Physical + digital', 'Working on both sides of the wall: wiring, power, equipment, networks, computers, and software.'],
  ['Practical implementation', 'Being most comfortable when something has to operate reliably in a real place for real people.'],
];

const experience = [
  ['2012–2020', 'SalemNet IT Solutions', 'Owner and independent contractor across IT, networking, low voltage, surveillance, access control, automation, and commercial AV.'],
  ['2014–2023', 'Cullen Technologies', 'Independent consulting, desktop and remote support, network configuration, firewalls, and systems troubleshooting.'],
  ['Detroit metro', 'Project work', 'Residential and commercial installations with organizations including Intellitech and Simply Tech.'],
  ['2024–2026', 'Electrical work', 'Residential and light-commercial electrical installations, power distribution, wiring, service work, and physical infrastructure.'],
  ['Current', 'Software & systems', 'Self-directed architecture and development across data processing, databases, containers, automation, and AI-assisted tools.'],
];

const journey = ['Computers', 'Networks', 'Building systems', 'Electrical', 'Software', 'Current experiments'];
---

<Layout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Matthew Salem · Work archive</p>
        <h1>Systems, infrastructure, technology—<span>from the physical layer up.</span></h1>
        <p class="hero-intro">I’ve spent much of my career working across IT, networking, low-voltage systems, commercial AV, automation, electrical work, and troubleshooting. More recently, that same problem-solving approach has taken me into software, infrastructure, and AI-assisted system development.</p>
        <div class="button-row">
          <a class="button" href="/work">View my work</a>
          <a class="button button-secondary" href="/background">Experience &amp; background</a>
        </div>
      </div>
      <aside class="hero-side">
        <strong>Archive note</strong>
        This site is a record of the work I’ve done, the systems I’ve built, and the things I’ve learned along the way. The archive is still being assembled.
      </aside>
    </div>
  </section>

  <section class="section-compact" aria-label="Selected project photographs">
    <div class="shell"><PhotoMosaic /></div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading label="Capability overview" title="What I work with" intro="The categories overlap because the work usually does. A network depends on the cable, the equipment, the power, the configuration, and the person who has to use it." />
      <div class="capability-grid">
        {capabilities.map((item, index) => (
          <article class="capability">
            <p class="capability-index">{String(index + 1).padStart(2, '0')}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading label="Selected work" title="A few points in the archive" intro="These entries establish the range now. They will become more detailed as photographs and field notes are recovered." />
      <div class="project-grid">
        {featured.map((project, index) => <ProjectCard project={project} large={index === 0} />)}
      </div>
      <div class="button-row"><a class="button button-secondary" href="/work">Browse all work</a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading label="Working method" title="How I tend to work" />
      <div class="method-grid">
        {methods.map(([title, text]) => <article class="method"><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading label="Experience snapshot" title="Work across the layers" intro="A compact view of the progression. Background holds the conventional details; Journey explains how the changes connect." />
      <div class="experience-list">
        {experience.map(([period, title, text]) => (
          <article class="experience-row"><p class="period">{period}</p><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
      <div class="button-row"><a class="text-link" href="/background">Read the full background <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading label="Journey preview" title="The work changed. The thread did not." intro="Each step added another layer to the same habit: understand the system, find the constraint, and learn what the problem requires." />
      <div class="journey-strip">
        {journey.map((title, index) => <div class="journey-stop"><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3></div>)}
      </div>
      <div class="button-row"><a class="text-link" href="/journey">Follow the journey <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell lab-callout">
      <div>
        <p class="eyebrow">Current work · Lab</p>
        <h2>The same systems thinking, now pushed into software.</h2>
        <p>Recent projects explore how complex information can be ingested, organized, traced, and reviewed—and how specialized tools can work together without obscuring where data came from.</p>
        <a class="text-link" href="/lab">Open the lab <span aria-hidden="true">→</span></a>
      </div>
      <ul class="lab-list">
        <li><span>TraceIQ</span> Information processing, relationships, timelines, and provenance.</li>
        <li><span>MCP platform</span> Shared interfaces for tools, stores, and longer-running workflows.</li>
        <li><span>Infrastructure</span> Databases, containers, APIs, automation, and iterative architecture.</li>
      </ul>
    </div>
  </section>
</Layout>
