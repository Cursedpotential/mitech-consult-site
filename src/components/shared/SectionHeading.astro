---
interface Props {
  label?: string;
  title: string;
  intro?: string;
}

const { label, title, intro } = Astro.props;
---

<header class="section-heading">
  {label && <p class="eyebrow">{label}</p>}
  <div class="section-heading-row">
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
</header>
